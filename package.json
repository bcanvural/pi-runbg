{
	"name": "pi-runbg",
	"version": "0.10.0",
	"description": "Long-lived background exec sessions for pi (codex unified_exec model): the LLM starts a session and drives it across turns with write_stdin polls, Ctrl-C, PTY, REPLs, dev servers. Full output logged to disk. Fork of pi-unified-exec v0.9.0.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"codex",
		"unified-exec",
		"runbg",
		"background",
		"bash",
		"pty"
	],
	"license": "MIT",
	"author": "Ren Wang <iamwrm@gmail.com>",
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "npm run check && tsx --test --test-timeout=120000 tests/*.test.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.5",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"optionalDependencies": {
		"@homebridge/node-pty-prebuilt-multiarch": "0.13.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0",
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typebox": "1.1.24",
		"typescript": "^5.6.0"
	}
}
